{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "D110 Studio",
  "version": "0.1.0",
  "identifier": "dev.rhonstin.d110studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "D110 Studio",
        "width": 1160,
        "height": 800,
        "minWidth": 820,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "category": "Utility",
    "shortDescription": "Bluetooth label editor for NIIMBOT D110",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libdbus-1-3", "bluez"] },
      "rpm": { "depends": ["webkit2gtk4.1", "gtk3", "dbus-libs", "bluez"] }
    }
  }
}
